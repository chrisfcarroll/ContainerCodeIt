#compdef code-it.sh claude-it.sh opencode-it.sh
# Zsh completion for code-it.sh, claude-it.sh and opencode-it.sh.
#
# Install by putting this directory on your fpath before compinit, e.g. in ~/.zshrc:
#     fpath=(/path/to/ContainerCodeIt/completions $fpath)
#     autoload -Uz compinit && compinit
#
# Completes the launcher's own options, and, after `--`, the flags of whichever
# coding agent the command line selects: claude-it.sh (or -c) completes Claude Code
# flags, opencode-it.sh (or -o, the default) completes OpenCode v2 flags; select
# opencode-v1 with --agent to complete v1 flags.
#     https://code.claude.com/docs/en/cli-reference
#     https://opencode.ai/docs/cli/

_code_it() {
    local cur prev agent=opencode seen_dashdash=0 i
    local -a opts

    cur=${words[CURRENT]}
    prev=${words[CURRENT-1]}

    # Which agent's flags to offer: the alias script chooses it, a later -c/-o wins
    case ${words[1]} in
        (*claude-it*) agent=claude ;;
    esac
    for (( i = 2; i < CURRENT; i++ )); do
        case ${words[i]} in
            (--claude|-c)   agent=claude ;;
            (--opencode|-o) agent=opencode ;;
            (--agent|-a)    agent=${words[i+1]} ;;
            (--)            seen_dashdash=1 ;;
        esac
    done

    if (( seen_dashdash )); then
        if [[ $agent == claude ]]; then
            # The flags people reach for most, not the full list
            case $prev in
                (--model|--fallback-model)
                    opts=(opus sonnet haiku claude-opus-5 claude-sonnet-5 claude-haiku-4-5) ;;
                (--permission-mode)
                    opts=(default acceptEdits plan auto dontAsk bypassPermissions manual) ;;
                (--effort)        opts=(low medium high xhigh max) ;;
                (--output-format) opts=(text json stream-json) ;;
                (--add-dir|--settings|--mcp-config) _files; return ;;
                (*) opts=(
                        --print -p --continue -c --resume -r --fork-session --model
                        --fallback-model --effort --agent --permission-mode
                        --dangerously-skip-permissions --allowed-tools --disallowed-tools
                        --add-dir --append-system-prompt --settings --mcp-config
                        --output-format --max-turns --max-budget-usd --verbose --debug --ide
                    ) ;;
            esac
        elif [[ $agent == opencode ]]; then
            case $prev in
                (--format) opts=(text json) ;;
                (--file) _files; return ;;
                (*) opts=(run mini --standalone --server --model --agent --prompt
                          --continue -c --session --format --file --help) ;;
            esac
        elif [[ $agent == codex ]]; then
            case $prev in
                (-m|--model)   opts=(gpt-6.1-sol gpt-6-sol gpt-6-luna gpt-6-astra o4-mini) ;;
                (-s|--sandbox) opts=(read-only workspace-write danger-full-access) ;;
                (-a|--ask-for-approval) opts=(on-request never) ;;
                (-c|--config)  return ;;   # free text key=value: leave it to the user
                (*) opts=(
                        exec resume login logout review mcp -m --model -s --sandbox
                        -a --ask-for-approval -p --profile -c --config -C --cd
                        --worktree --search --add-dir -i --image --oss
                    ) ;;
            esac
        else
            # opencode-v1: the flags people reach for most, not the full list
            case $prev in
                (--format)   opts=(default json) ;;
                (--file|-f)  _files; return ;;
                (--dir)      _files -/; return ;;
                (*) opts=(
                        run --continue -c --session -s --fork --prompt --model -m
                        --agent --auto --port --hostname --share --file -f --format
                        --title --thinking --variant --dir
                    ) ;;
            esac
        fi
        compadd -- $opts
        return
    fi

    case $prev in
        (--work-dir|-w|--save-dir|-s) _files -/; return ;;
        (--runtime|-r)    compadd -- docker container; return ;;
        (--env|-e)        _parameters; return ;;
        (--env-file)      _files; return ;;
        (--image|-i)      compadd -- $(docker images --format '{{.Repository}}' 2>/dev/null); return ;;
        (--agent-name) compadd -- Agent1; return ;;
        (--locale|-l)  compadd -- like-host C.UTF-8; return ;;
        (--agent|-a)   compadd -- $(command ls "${0:A:h}/../agents" 2>/dev/null); return ;;
        (--toolchain|-t|--stack) compadd -- dotnet node js-node ts-node bun js-bun ts-bun python uv powershell pwsh; return ;;
        (--package-caches) compadd -- nuget npm bun; return ;;
        (--prompt|-p|--run-arg|--docker-arg) return ;;   # free text: leave it to the user
    esac

    compadd -- --agent -a --list-agents --opencode -o --claude -c --no-agent --zsh --prompt -p --headless \
        --work-dir -w --save-dir -s --image -i \
        --runtime -r --locale -l --agent-name --toolchain -t --stack \
        --package-caches --env -e --env-file --run-arg --docker-arg --dry-run -d --help -h --
}

_code_it "$@"
