#compdef code-it-add-agent.sh
# Zsh completion for code-it-add-agent.sh.
#
# Install by putting this directory on your fpath before compinit.

_code_it_add_agent() {
    local prev
    prev=${words[CURRENT-1]}

    case $prev in
        (--repo|--code-it) _files -/; return ;;
        (--url|--branch)   return ;;   # free text
    esac

    compadd -- --url --repo --code-it --branch --dry-run -d --help -h
}

_code_it_add_agent "$@"
