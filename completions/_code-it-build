#compdef code-it-build.sh
# Zsh completion for code-it-build.sh.
#
# Install by putting this directory on your fpath before compinit.

_code_it_build() {
    local cur prev
    local -a opts

    cur=${words[CURRENT]}
    prev=${words[CURRENT-1]}

    case $prev in
        (--dockerfile-dir) _files -/; return ;;
        (--runtime|-r)     compadd -- docker container; return ;;
        (--image|-i)       compadd -- code-it-alpine-dotnet-node; return ;;
        (--toolchain|-t|--stack) compadd -- dotnet node js-node ts-node bun js-bun ts-bun python uv; return ;;
        (--package-caches) compadd -- nuget npm bun; return ;;
        (--agent|-a)       compadd -- $(command ls "${0:A:h}/../agents" 2>/dev/null); return ;;
    esac

    compadd -- --toolchain -t --stack --package-caches --agent -a --list-agents \
        --rebuild --image -i --dockerfile-dir --runtime -r --dry-run -d --help -h
}

_code_it_build "$@"
