# OpenCode v1 agent definition: `opencode` means v2 since its GA, so v1 is this
# separate option. Readable from bash (it is sourced) and PowerShell (parsed as
# key=value). Keep one key per line.
AGENT_NAME=opencode-v1
AGENT_SHORT=
AGENT_COMMAND=opencode
AGENT_BINARY=/home/agent1/.opencode/bin/opencode
AGENT_INSTALL=install.dockerfile
AGENT_CONFIG_LABEL='OpenCode v1 configuration'
# How code-it-defaults sets the agent's default model: a JSON file under its save
# dir, and the top-level key to set there
AGENT_MODEL_FILE='.config/opencode/config.json:model'
# V2 is `opencode` now, but v1 reads the same paths, so v1 keeps its state at the
# root of --save-dir, where it has lived all along: no AGENT_SAVE_SUBDIR.
# State created under --save-dir and mounted into the container home
AGENT_STATE_DIRS='.config/opencode:.local/share/opencode'
AGENT_STATE_FILES=''
# One container at a time: concurrent containers corrupt its SQLite session database.
# A second container gets its own copy, with auth.json carried over.
AGENT_EXCLUSIVE_DIRS='.local/share/opencode'
AGENT_EXCLUSIVE_CARRY='.local/share/opencode/auth.json'
# Prompt translation: {args} is the agent arguments, {prompt} the opening prompt
AGENT_CMD_INTERACTIVE_PROMPT='--prompt {prompt} {args}'
AGENT_CMD_INTERACTIVE_NO_PROMPT='{args}'
AGENT_CMD_HEADLESS_PROMPT='run {args} {prompt}'
AGENT_CMD_HEADLESS_NO_PROMPT='run {args}'
