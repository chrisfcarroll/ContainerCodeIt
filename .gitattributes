# Default: let Git handle text files normally
* text=auto

# Dockerfiles, shell files and files for use in the VMs must always be LF (no CRLF)
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf
*.env text eol=lf
*.sh text eol=lf
*.bash text eol=lf
completions/_code-it* text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
# Read by the bash scripts, which would otherwise see a trailing \r in every value
config text eol=lf
lib/*.txt text eol=lf
